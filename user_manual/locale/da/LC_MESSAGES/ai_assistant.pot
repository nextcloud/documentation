#: ../../ai_assistant.rst:289
msgid "Example prompt: *\"Create a recipe for Guacamole in my cookbook.\"*"
msgstr "Eksempel på prompt: *\"Opret en opskrift på guacamole i min kogebog.\"*"

#: ../../ai_assistant.rst:291
