msgstr "Visa återställningsfrasen på en Android-enhet"

#: ../../files/using_e2ee.rst:271
msgid "Displaying the mnemonic on an iOS device"
msgstr "Visa återställningsfrasen på en iOS-enhet"

#: ../../files/using_e2ee.rst:287
msgid "It is not possible to display the mnemonic in the browser."
msgstr "Det går inte att visa återställningsfrasen i webbläsaren."
