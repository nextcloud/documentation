msgstr "Cliquer sur l'icône de courriel dans le bandeau"

#: ../../groupware/mail.rst:56
msgid "Fill up the login form (auto or manual)"
msgstr "Compléter le formulaire de connexion (automatique ou manuel)"

#: ../../groupware/mail.rst:61
msgid "Change sort order"
msgstr "Modifier l'ordre de tri"

#: ../../groupware/mail.rst:66
msgid "Go to *Sorting*"
msgstr "Aller à *Trier*"

#: ../../groupware/mail.rst:67
msgid "You can choose *Oldest* or *Newest* mail first"
msgstr ""
"Vous pouvez choisir d'afficher en premier les messages *Plus récent* ou "
"*Plus ancien*"

#: ../../groupware/mail.rst:69
msgid "This change will apply across all your accounts and folders"
msgstr "Ce changement sera appliqué sur tous vos comptes et dossiers"

#: ../../groupware/mail.rst:72
msgid "Sort favorites up"
msgstr "Afficher les favoris d'abord"

#: ../../groupware/mail.rst:74
