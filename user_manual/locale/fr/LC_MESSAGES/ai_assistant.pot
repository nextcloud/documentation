"Exemple de prompt : *\"Partage mon fichier Projets de randonnées.md avec "
"l'équipe Groupe de randonnée.\"*"

#: ../../ai_assistant.rst:258
msgid "Contacts tools"
msgstr "Outils de Contacts"

#: ../../ai_assistant.rst:260
msgid "Find a contact"
msgstr "Trouver un contact"

#: ../../ai_assistant.rst:262
msgid "Example prompt: *\"What is Anna's email address?\"*"
msgstr "Exemple de prompt : *\"Quelle est l'adresse e-mail d'Anne ?\"*"

#: ../../ai_assistant.rst:264
msgid "Find a user's ID"
msgstr "Trouver l'ID d'un utilisateur"

#: ../../ai_assistant.rst:266
msgid "Example prompt: *\"What is Ralph's userID?\"*"
msgstr "Exemple de prompt : *\"Quel est l'ID utilisateur de Ralph ?\"*"

#: ../../ai_assistant.rst:268
msgid "Find the current user's details"
