#: ../../desktop/commandline.rst:127
msgid "``--confdir <directory>``"
msgstr "``--confdir <directory>``"

#: ../../desktop/commandline.rst:128
msgid "Standard location"
msgstr "Emplacement standard"

#: ../../desktop/commandline.rst:129
msgid ""
"Use a different configuration directory. Does not make the one-run sync "
"inherit all desktop sync settings."
msgstr ""
"Utiliser un répertoire de configuration différent. Cette option ne fait pas "
"hériter la synchronisation ponctuelle de tous les paramètres de "
"synchronisation du bureau."

#: ../../desktop/commandline.rst:130
msgid "``--version``, ``-v``"
msgstr "``--version``, ``-v``"

#: ../../desktop/commandline.rst:131
msgid "Not requested"
msgstr "Non demandé"

#: ../../desktop/commandline.rst:132
msgid ""
"Display version information and exit. Run this option without the directory "
"and server arguments."
msgstr ""
"Afficher les informations de version et quitter. Exécutez cette option sans "
"les arguments du répertoire et du serveur."

#: ../../desktop/commandline.rst:138
msgid "Credential handling"
msgstr "Gestion des identifiants"

#: ../../desktop/commandline.rst:140
msgid "Credentials are read in this order:"
msgstr "Les identifiants sont lus dans cet ordre :"

#: ../../desktop/commandline.rst:142
