#: ../../files/external_storage.rst:5
msgid "Using external storage"
msgstr ""

#: ../../files/external_storage.rst:7
msgid "The External Storage application lets your Nextcloud server connect to remote file systems — such as Amazon S3, SFTP servers, SMB/CIFS shares, or WebDAV servers — and present them as folders inside your Files view. Your administration team configures which backends are available and which mounts are shared with you."
msgstr ""

#: ../../files/external_storage.rst:12
msgid "If your administrator has enabled user-managed external storage, you can also add your own connections under Personal Settings."
msgstr ""

#: ../../files/external_storage.rst:16
msgid "Accessing external storage"
msgstr ""

#: ../../files/external_storage.rst:18
msgid "External storage mounts appear as regular folders in your Files view. You can browse, upload, download, and delete files in them just as you would any other folder. Whether sharing is available depends on whether your administrator has enabled it for each individual mount."
msgstr ""

#: ../../files/external_storage.rst:23
msgid "A colored indicator next to the folder name shows the connection status:"
msgstr ""

#: ../../files/external_storage.rst:25
msgid "Green — the storage is connected and ready to use."
msgstr ""

#: ../../files/external_storage.rst:26
msgid "Yellow — the storage could not be reached; Nextcloud will retry automatically."
msgstr ""

#: ../../files/external_storage.rst:27
msgid "Red — the storage is unavailable. Contact your administrator if this persists."
msgstr ""

#: ../../files/external_storage.rst:29
msgid "When a mount is unavailable, Nextcloud marks it as offline for ten minutes before retrying. You can trigger a manual recheck by clicking the status indicator."
msgstr ""

#: ../../files/external_storage.rst:33
msgid "Some external storage mounts may be read-only. You will not be able to upload or delete files on a read-only mount."
msgstr ""

#: ../../files/external_storage.rst:37
msgid "Sharing files from external storage"
msgstr ""

#: ../../files/external_storage.rst:39
msgid "Sharing from an external storage mount works the same as sharing any other file or folder — use the share icon in the Files view. Sharing must be explicitly enabled on each mount by your administrator, so the share icon may not be available on all mounts."
msgstr ""

#: ../../files/external_storage.rst:45
msgid "Server-side encryption is not available for external mounts pointing to other Nextcloud instances."
msgstr ""

#: ../../files/external_storage.rst:49
msgid "Adding your own external storage"
msgstr ""

#: ../../files/external_storage.rst:51
msgid "If your administrator has enabled user-managed external storage, you can connect your own storage services under **Personal Settings → External Storage**."
msgstr ""

#: ../../files/external_storage.rst:54
msgid "To add a new mount:"
msgstr ""

#: ../../files/external_storage.rst:56
msgid "Click your profile icon and select **Personal Settings**."
msgstr ""

#: ../../files/external_storage.rst:57
msgid "Select **External Storage** from the left sidebar."
msgstr ""

#: ../../files/external_storage.rst:58
msgid "Choose a backend from the **Add storage** dropdown."
msgstr ""

#: ../../files/external_storage.rst:59
msgid "Fill in the required fields for the backend (server address, path, credentials, etc.)."
msgstr ""

#: ../../files/external_storage.rst:60
msgid "Select an authentication method from the **Authentication** dropdown."
msgstr ""

#: ../../files/external_storage.rst:62
msgid "Required fields are marked with a red border. Once all required fields are filled, the mount is saved automatically."
msgstr ""

#: ../../files/external_storage.rst:65
msgid "A green dot next to the mount confirms a successful connection. A red or yellow icon means Nextcloud could not connect — check your credentials and network settings."
msgstr ""

#: ../../files/external_storage.rst:68
msgid "To remove a mount, open the three-dot overflow menu next to it and select **Delete**."
msgstr ""

#: ../../files/external_storage.rst:71
msgid "Mounts you add under Personal Settings are visible only to your account."
msgstr ""

#: ../../files/external_storage.rst:74
msgid "Supported backends"
msgstr ""

#: ../../files/external_storage.rst:76
msgid "The following backends may be available, depending on what your administrator has enabled:"
msgstr ""

#: ../../files/external_storage.rst:79
msgid "**Amazon S3** — Amazon Simple Storage Service buckets and S3-compatible storage."
msgstr ""

#: ../../files/external_storage.rst:80
msgid "**FTP** — FTP and FTPS servers."
msgstr ""

#: ../../files/external_storage.rst:81
msgid "**Nextcloud / ownCloud** — Another Nextcloud or ownCloud instance over WebDAV."
msgstr ""

#: ../../files/external_storage.rst:82
msgid "**OpenStack Object Storage** — OpenStack Swift buckets."
msgstr ""

#: ../../files/external_storage.rst:83
msgid "**SFTP** — SSH File Transfer Protocol servers."
msgstr ""

#: ../../files/external_storage.rst:84
msgid "**SMB / CIFS** — Windows file shares and Samba servers."
msgstr ""

#: ../../files/external_storage.rst:85
msgid "**WebDAV** — Any WebDAV-compatible server."
msgstr ""

#: ../../files/external_storage.rst:87
msgid "For backend-specific configuration details, see `Configuring External Storage (GUI) <https://docs.nextcloud.com/server/latest/admin_manual/configuration_files/external_storage_configuration_gui.html>`_ in the Administrator's manual."
msgstr ""

#: ../../files/external_storage.rst:92
msgid "File change detection"
msgstr ""

#: ../../files/external_storage.rst:94
msgid "Files you add or change through Nextcloud are reflected immediately. Files added or changed directly on the external storage — without going through Nextcloud — may not appear until the next background scan."
msgstr ""

#: ../../files/external_storage.rst:98
msgid "If externally added files are not appearing, ask your administrator to run ``occ files:scan`` or to configure a periodic background scan for the mount."
msgstr ""
