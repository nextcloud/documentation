#: ../../desktop/advanced_configuration.rst:364
msgid "Force the server URL in the next account setup and start login automatically. Cleared after successful wizard setup. Can also be set with ``--overrideserverurl``."
msgstr ""

#: ../../desktop/advanced_configuration.rst:366
msgid "``overrideLocalDir``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:368
msgid "Suggested local directory for account setup. Cleared after successful wizard setup. Can also be set with ``--overridelocaldir``."
msgstr ""

#: ../../desktop/advanced_configuration.rst:370
msgid "``isVfsEnabled``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:372
msgid "Virtual-file preference used with ``overrideServerUrl`` during setup. Does not convert existing sync folders or enable macOS File Provider mode."
msgstr ""

#: ../../desktop/advanced_configuration.rst:376
msgid "Per-account network settings"
msgstr ""

#: ../../desktop/advanced_configuration.rst:378
msgid "Use the account's network settings in the app where possible. Values below belong to the existing account group inside ``[Accounts]``. In the INI file they appear with the account ID prefix, for example ``0\\networkProxyType=0`` for account ``0``. Use the account ID already present in your file. Proxy passwords belong in the system keychain."
msgstr ""

#: ../../desktop/advanced_configuration.rst:390
msgid "``networkProxyType``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:391
msgid "``0`` if absent"
msgstr ""

#: ../../desktop/advanced_configuration.rst:392
msgid "``0``: system proxy; ``1``: SOCKS5 proxy; ``2``: no proxy; ``3``: HTTP proxy. Account setup or migration can store a different value."
msgstr ""

#: ../../desktop/advanced_configuration.rst:394
msgid "``networkProxyHostName``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:396
msgid "Proxy hostname."
msgstr ""

#: ../../desktop/advanced_configuration.rst:397
msgid "``networkProxyPort``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:399
msgid "Proxy port. Set the actual port when configuring a manual proxy."
msgstr ""

#: ../../desktop/advanced_configuration.rst:400
msgid "``networkProxyNeedsAuth``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:402
msgid "Whether the proxy requires authentication."
msgstr ""

#: ../../desktop/advanced_configuration.rst:403
msgid "``networkProxyUser``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:405
msgid "Proxy username."
msgstr ""

#: ../../desktop/advanced_configuration.rst:406
msgid "``networkUploadLimitSetting``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:408
msgid "Upload limit mode: ``0`` for unlimited, ``1`` for a manual limit. Negative values are reserved for legacy migration."
msgstr ""

#: ../../desktop/advanced_configuration.rst:410
msgid "``networkDownloadLimitSetting``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:412
msgid "Download limit mode: ``0`` for unlimited, ``1`` for a manual limit. Negative values are reserved for legacy migration."
msgstr ""

#: ../../desktop/advanced_configuration.rst:414
msgid "``networkUploadLimit``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:415
#: ../../desktop/advanced_configuration.rst:418
msgid "``0`` KB/s"
msgstr ""

#: ../../desktop/advanced_configuration.rst:416
msgid "Manual upload limit, used when ``networkUploadLimitSetting`` is ``1``."
msgstr ""

#: ../../desktop/advanced_configuration.rst:417
msgid "``networkDownloadLimit``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:419
msgid "Manual download limit, used when ``networkDownloadLimitSetting`` is ``1``."
msgstr ""

#: ../../desktop/advanced_configuration.rst:424
msgid "Legacy proxy settings"
msgstr ""

#: ../../desktop/advanced_configuration.rst:426
msgid "The top-level ``[Proxy]`` section is retained for migration from older clients. Current desktop accounts use the per-account settings above. Legacy proxy settings can be removed automatically after migration."
msgstr ""

#: ../../desktop/advanced_configuration.rst:437
msgid "``type``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:439
msgid "Legacy proxy type: ``0`` for system proxy, ``1`` for SOCKS5, ``2`` for no proxy, or ``3`` for HTTP proxy."
msgstr ""

#: ../../desktop/advanced_configuration.rst:440
msgid "``host``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:442
msgid "Legacy proxy hostname."
msgstr ""

#: ../../desktop/advanced_configuration.rst:443
msgid "``port``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:445
msgid "Legacy proxy port."
msgstr ""

#: ../../desktop/advanced_configuration.rst:446
msgid "``needsAuth``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:448
msgid "Whether the legacy proxy requires authentication."
msgstr ""

#: ../../desktop/advanced_configuration.rst:449
msgid "``user``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:451
msgid "Legacy proxy username."
msgstr ""

#: ../../desktop/advanced_configuration.rst:456
msgid "Environment variables"
msgstr ""

#: ../../desktop/advanced_configuration.rst:458
msgid "Set environment variables before starting the client. A variable set in a terminal applies to processes launched from that terminal; an already running client or a client launched from the desktop does not automatically inherit it. For example, temporarily change the network inactivity timeout on Linux:"
msgstr ""

#: ../../desktop/advanced_configuration.rst:466
msgid "The historic ``OWNCLOUD_`` prefix is still used by the Nextcloud client. Follow the value format in each description: some switches require ``0`` or ``1``, while others react to any nonempty value, including ``0``. ``Default`` describes behavior when the variable is unset."
msgstr ""

#: ../../desktop/advanced_configuration.rst:471
msgid "Transfer settings"
msgstr ""

#: ../../desktop/advanced_configuration.rst:473
msgid "The chunk-size and parallel-job overrides apply after configuration values and server capabilities in desktop classic sync. ``nextcloudcmd`` also reads these variables, but starts with its sync-engine defaults instead of the desktop app's chunk configuration."
msgstr ""

#: ../../desktop/advanced_configuration.rst:485
msgid "``OWNCLOUD_CHUNK_SIZE``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:486
msgid "Effective chunk size"
msgstr ""

#: ../../desktop/advanced_configuration.rst:487
msgid "Initial chunk size in bytes. Desktop sync starts from ``chunkSize`` or the server-provided size. ``nextcloudcmd`` defaults to ``104857600`` bytes (100 MiB)."
msgstr ""

#: ../../desktop/advanced_configuration.rst:489
msgid "``OWNCLOUD_MIN_CHUNK_SIZE``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:490
msgid "Effective minimum"
msgstr ""

#: ../../desktop/advanced_configuration.rst:491
msgid "Minimum chunk size in bytes. Desktop sync starts from ``minChunkSize``; ``nextcloudcmd`` defaults to ``5000000`` bytes (5 MB)."
msgstr ""

#: ../../desktop/advanced_configuration.rst:493
msgid "``OWNCLOUD_MAX_CHUNK_SIZE``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:494
msgid "Effective maximum"
msgstr ""

#: ../../desktop/advanced_configuration.rst:495
msgid "Maximum chunk size in bytes. Desktop sync starts from ``maxChunkSize`` or the server-provided maximum; ``nextcloudcmd`` defaults to ``5000000000`` bytes (5 GB)."
msgstr ""

#: ../../desktop/advanced_configuration.rst:497
msgid "``OWNCLOUD_TARGET_CHUNK_UPLOAD_DURATION``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:499
msgid "Target duration for dynamic chunk sizing (1 minute). Use ``0`` to disable dynamic sizing. The similarly named configuration-file key has no effect."
msgstr ""

#: ../../desktop/advanced_configuration.rst:501
msgid "``OWNCLOUD_MAX_PARALLEL``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:502
msgid "Server/protocol dependent"
msgstr ""

#: ../../desktop/advanced_configuration.rst:503
msgid "Positive maximum number of parallel sync jobs. Desktop sync uses the server-provided value when available; otherwise it uses ``20`` for HTTP/2 or ``6`` for HTTP/1. ``nextcloudcmd`` defaults to ``6``. This is not the number of simultaneous file transfers."
msgstr ""

#: ../../desktop/advanced_configuration.rst:506
msgid "``OWNCLOUD_TIMEOUT``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:507
msgid "``timeout`` or 300 seconds"
msgstr ""

#: ../../desktop/advanced_configuration.rst:508
msgid "Network inactivity timeout. A nonzero integer overrides ``timeout`` in the desktop app. ``nextcloudcmd`` defaults to 300 seconds. Zero or an invalid value uses the normal default."
msgstr ""

#: ../../desktop/advanced_configuration.rst:510
msgid "``OWNCLOUD_HTTP2_ENABLED``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:511
#: ../../desktop/advanced_configuration.rst:527
msgid "Disabled"
msgstr ""

#: ../../desktop/advanced_configuration.rst:512
msgid "Set to ``1`` to allow HTTP/2 for HTTPS requests. Other values disable it. Actual use still depends on the server and network connection."
msgstr ""

#: ../../desktop/advanced_configuration.rst:514
msgid "``OWNCLOUD_CHUNKING_NG``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:515
#: ../../desktop/advanced_configuration.rst:519
#: ../../desktop/advanced_configuration.rst:565
msgid "Server capability"
msgstr ""

#: ../../desktop/advanced_configuration.rst:516
msgid "Set to ``0`` to disable the newer chunked-upload protocol or ``1`` to force it. Other values use the server capability. Only force it when the server supports it."
msgstr ""

#: ../../desktop/advanced_configuration.rst:518
msgid "``NEXTCLOUD_BULK_UPLOAD``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:520
msgid "Set to ``0`` to disable bulk uploads or ``1`` to force them. Other values use the server capability. Only force them when the server supports them."
msgstr ""

#: ../../desktop/advanced_configuration.rst:522
msgid "``OWNCLOUD_PARALLEL_CHUNK``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:523
msgid "Server dependent"
msgstr ""

#: ../../desktop/advanced_configuration.rst:524
msgid "For the legacy chunked-upload path only: ``0`` or ``false`` disables parallel chunks. Other nonempty values enable them unless the server disables them."
msgstr ""

#: ../../desktop/advanced_configuration.rst:526
msgid "``OWNCLOUD_LAZYOPS``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:528
msgid "A nonzero integer adds the ``OC-LazyOps: true`` header to upload requests. Its effect depends on server support."
msgstr ""

#: ../../desktop/advanced_configuration.rst:531
msgid "Keep chunk sizes positive. The client adjusts the minimum and maximum to include the initial chunk size. The environment parser accepts unsigned 32-bit byte values for the three chunk-size overrides, so do not use values above ``4294967295`` bytes for those variables."
msgstr ""

#: ../../desktop/advanced_configuration.rst:536
msgid "Synchronization and disk space"
msgstr ""

#: ../../desktop/advanced_configuration.rst:546
msgid "``OWNCLOUD_FULL_LOCAL_DISCOVERY_INTERVAL``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:548
msgid "Desktop classic sync only. Override the full local scan interval in milliseconds. Use ``-1`` to disable periodic full scans."
msgstr ""

#: ../../desktop/advanced_configuration.rst:550
msgid "``OWNCLOUD_CRITICAL_FREE_SPACE_BYTES``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:551
msgid "``512000000`` bytes"
msgstr ""

#: ../../desktop/advanced_configuration.rst:552
msgid "Abort the folder sync when remaining local space is below this threshold (512 MB). The value is bounded between zero and ``OWNCLOUD_FREE_SPACE_BYTES``."
msgstr ""

#: ../../desktop/advanced_configuration.rst:554
msgid "``OWNCLOUD_FREE_SPACE_BYTES``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:555
msgid "``1000000000`` bytes"
msgstr ""

#: ../../desktop/advanced_configuration.rst:556
msgid "Skip or abort downloads that would leave less than this amount of local free space (1 GB). Other synchronization can continue."
msgstr ""

#: ../../desktop/advanced_configuration.rst:558
msgid "``OWNCLOUD_BLACKLIST_TIME_MIN``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:559
msgid "``25`` seconds"
msgstr ""

#: ../../desktop/advanced_configuration.rst:560
msgid "Minimum retry delay for files that failed to synchronize. Values below ``25`` are raised to ``25``."
msgstr ""

#: ../../desktop/advanced_configuration.rst:561
msgid "``OWNCLOUD_BLACKLIST_TIME_MAX``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:562
msgid "``86400`` seconds"
msgstr ""

#: ../../desktop/advanced_configuration.rst:563
msgid "Maximum retry delay for files that failed to synchronize (1 day). Only positive values override the default."
msgstr ""

#: ../../desktop/advanced_configuration.rst:564
msgid "``OWNCLOUD_UPLOAD_CONFLICT_FILES``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:566
msgid "Set to ``1`` to upload conflict copies or ``0`` to prevent their upload. A nonempty value overrides the server setting. See :doc:`conflicts`."
msgstr ""

#: ../../desktop/advanced_configuration.rst:571
msgid "Downloads skipped because of the free-space threshold are retried in later sync runs. The critical threshold stops the whole folder sync. These limits are independent of your server storage quota."
msgstr ""

#: ../../desktop/advanced_configuration.rst:575
msgid "Checksums"
msgstr ""

#: ../../desktop/advanced_configuration.rst:585
msgid "``OWNCLOUD_CONTENT_CHECKSUM_TYPE``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:586
msgid "Server preference, then ``SHA1``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:587
msgid "Override the preferred upload checksum algorithm. Choose an algorithm supported by both client and server."
msgstr ""

#: ../../desktop/advanced_configuration.rst:588
msgid "``OWNCLOUD_DISABLE_CHECKSUM_UPLOAD``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:589
#: ../../desktop/advanced_configuration.rst:592
#: ../../desktop/advanced_configuration.rst:621
msgid "Unset"
msgstr ""

#: ../../desktop/advanced_configuration.rst:590
msgid "Any nonempty value disables sending upload checksums. Unset it to restore normal checksum uploads."
msgstr ""

#: ../../desktop/advanced_configuration.rst:591
msgid "``OWNCLOUD_DISABLE_CHECKSUM_COMPUTATIONS``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:593
msgid "Any nonempty value disables synchronous checksum calculations. Upload and download paths using asynchronous calculations still run."
msgstr ""

#: ../../desktop/advanced_configuration.rst:596
msgid "Use checksum overrides only when diagnosing a specific compatibility problem; disabling checksums reduces integrity checks used during synchronization."
msgstr ""

#: ../../desktop/advanced_configuration.rst:600
msgid "Troubleshooting"
msgstr ""

#: ../../desktop/advanced_configuration.rst:610
msgid "``OWNCLOUD_SQLITE_JOURNAL_MODE``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:611
msgid "``WAL`` or ``DELETE``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:612
msgid "Override the sync journal database mode. Normally ``WAL``; ``DELETE`` on Windows FAT filesystems and macOS sync paths under ``/Volumes/``. Change only when diagnosing a database compatibility problem."
msgstr ""

#: ../../desktop/advanced_configuration.rst:614
msgid "``OWNCLOUD_SQLITE_LOCKING_MODE``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:615
msgid "``EXCLUSIVE``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:616
msgid "Override the SQLite locking mode for the sync journal database."
msgstr ""

#: ../../desktop/advanced_configuration.rst:617
msgid "``OWNCLOUD_SQLITE_TEMP_STORE``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:618
msgid "SQLite default"
msgstr ""

#: ../../desktop/advanced_configuration.rst:619
msgid "Override the SQLite ``temp_store`` setting for the sync journal database."
msgstr ""

#: ../../desktop/advanced_configuration.rst:620
msgid "``OWNCLOUD_CORE_DUMP``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:622
msgid "On Unix systems, any nonempty value requests an unlimited core-dump size limit for the desktop app. Operating system restrictions still apply."
msgstr ""

#: ../../desktop/advanced_configuration.rst:624
msgid "``QT_LOGGING_RULES``"
msgstr ""

#: ../../desktop/advanced_configuration.rst:625
msgid "Qt logging defaults"
msgstr ""

#: ../../desktop/advanced_configuration.rst:626
msgid "Set logging-category filters, for example ``nextcloud.*.debug=true``. This Qt variable also allows selecting individual categories."
msgstr ""

#: ../../desktop/advanced_configuration.rst:629
msgid "For ``nextcloudcmd`` credentials, see :ref:`desktop-command-line-credentials`. Its ``NC_USER`` and ``NC_PASSWORD`` variables do not configure accounts in the desktop app."
msgstr ""
