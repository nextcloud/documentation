#: ../../groupware/sync_windows10.rst:3
msgid "Synchronizing with Windows 10"
msgstr ""

#: ../../groupware/sync_windows10.rst:8
msgid "Calendar"
msgstr ""

#: ../../groupware/sync_windows10.rst:10
msgid "In your browser, navigate to the Nextcloud Calendar app. Under \"Calendar settings\", copy the address using \"Copy iOS/macOS CalDAV address\" into your clipboard."
msgstr ""

#: ../../groupware/sync_windows10.rst:12
msgid "Launch the Windows 10 Calendar app. Then, click the settings icon (gear icon) and select \"Manage accounts\"."
msgstr ""

#: ../../groupware/sync_windows10.rst:14
msgid "Click \"Add account\" and choose \"iCloud\"."
msgstr ""

#: ../../groupware/sync_windows10.rst:16
msgid "Enter an email, username and password. None of this information has to be valid-it will all be changed in the upcoming steps."
msgstr ""

#: ../../groupware/sync_windows10.rst:18
msgid "Click \"Done\". A message should appear indicating the settings were saved successfully."
msgstr ""

#: ../../groupware/sync_windows10.rst:20
msgid "In the \"Manage Accounts\" menu, click on  the iCloud account created in previous steps, and select \"Change settings\". Then, click on \"Change mailbox sync settings\"."
msgstr ""

#: ../../groupware/sync_windows10.rst:22
msgid "Scroll to the bottom of the dialog box, select \"Advanced mailbox settings\". Scroll once more to the bottom of the dialog box and paste your CalDAV URL in the field labelled \"Calendar server (CalDAV)\"."
msgstr ""

#: ../../groupware/sync_windows10.rst:24
msgid "Click \"Done\". Enter your Nextcloud username and password in the appropriate fields, and change the account name to whatever you prefer (e. g. \"Nextcloud Calendar\"). Click \"Save\"."
msgstr ""

#: ../../groupware/sync_windows10.rst:27
msgid "Contacts"
msgstr ""

#: ../../groupware/sync_windows10.rst:29
msgid "Repeat steps 1–7 from the :ref:`Calendar instructions <calendar-section>`. If you already have set up the Calendar synchronization, you can use the same account for this."
msgstr ""

#: ../../groupware/sync_windows10.rst:31
msgid "From the \"Advanced mailbox settings\" screen, scroll to the bottom of the dialog box and paste your CardDAV URL in the field labelled \"Contacts server (CardDAV)\"."
msgstr ""

#: ../../groupware/sync_windows10.rst:33
msgid "Replace the path \"principals\" within the URL with \"addressbooks\"."
msgstr ""

#: ../../groupware/sync_windows10.rst:35
msgid "Click \"Done\". Enter your Nextcloud username and password in the appropriate fields, and change the account name to whatever you prefer (e. g. \"Nextcloud\"). Click \"Save\"."
msgstr ""

#: ../../groupware/sync_windows10.rst:38
msgid "Troubleshooting: 2FA"
msgstr ""

#: ../../groupware/sync_windows10.rst:40
msgid "**NOTE: You will not be able to synchronize your calendar if you have two-factor authentication enabled. Follow the steps below to get an app password that can be used with the Calendar client app:**"
msgstr ""

#: ../../groupware/sync_windows10.rst:42
msgid "Log into Nextcloud. Click on your user icon, then click on \"Settings\"."
msgstr ""

#: ../../groupware/sync_windows10.rst:44
msgid "Click on \"Security\", then locate a button labeled \"Create new app password\". Next to this button, enter \"Windows 10 Calendar app\". Then, click the button, copy and paste the password. Use this password instead of your Nextcloud password when prompted for credentials during setup, for example in Calendar step 8 or Contacts step 4."
msgstr ""

#: ../../groupware/sync_windows10.rst:47
msgid "Troubleshooting: TLSv1.2"
msgstr ""

#: ../../groupware/sync_windows10.rst:49
msgid "For Windows 10 your Nextcloud https server `must support TLSv1.2 <https://docs.microsoft.com/en-us/windows/win32/secauthn/protocols-in-tls-ssl--schannel-ssp->`_.  This is apparent if no connection attempts are seen on the server, and the Windows client Event Viewer will display Schannel TLS errors under \"Windows Logs -> System\"."
msgstr ""

