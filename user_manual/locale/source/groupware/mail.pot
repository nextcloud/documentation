msgstr ""

#: ../../groupware/mail.rst:204
msgid "Nextcloud Mail"
msgstr ""

#: ../../groupware/mail.rst:206
msgid "Native account delegation lets you grant other Nextcloud users access to one of your mail accounts directly from the app, without any server-side alias configuration. A delegate can do everything the account owner can — send, receive, and delete mail on your behalf — except deleting the account or updating its authentication information."
msgstr ""

