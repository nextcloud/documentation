#: ../../groupware/user_migration.rst:3
msgid "Migrate data between instances"
msgstr ""

#: ../../groupware/user_migration.rst:5
msgid "The `User Migration App <https://apps.nextcloud.com/apps/user_migration>`_ lets you move your Nextcloud Groupware data between instances."
msgstr ""

#: ../../groupware/user_migration.rst:8
msgid "The following data can be migrated:"
msgstr ""

#: ../../groupware/user_migration.rst:10
msgid "Contacts and groups"
msgstr ""

#: ../../groupware/user_migration.rst:11
msgid "Calendars including events, details and attendees"
msgstr ""

#: ../../groupware/user_migration.rst:12
msgid "Calendar app settings including appointment and proposal schedule configurations"
msgstr ""

#: ../../groupware/user_migration.rst:13
msgid "Mail account parameters, aliases and preferences"
msgstr ""

#: ../../groupware/user_migration.rst:16
msgid "The User Migration App must be installed on both instances, along with the latest version of the respective Nextcloud Groupware app."
msgstr ""

#: ../../groupware/user_migration.rst:19
msgid "Once the User Migration App is installed, you can start the migration process by going to your **Personal settings** and clicking on **Data migration** on the left side. You can choose which data you want to migrate and start the export process. Once the export is finished, download the generated file and import it onto the new instance by going to the same section."
msgstr ""
