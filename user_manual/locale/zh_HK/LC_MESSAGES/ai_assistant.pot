#: ../../ai_assistant.rst:270
msgid "Example prompt: *\"Where do I live?\"*"
msgstr "提示詞範例：*「我住在哪裏？」*"

#: ../../ai_assistant.rst:273
msgid "Cookbook tools"
msgstr "食譜工具"

#: ../../ai_assistant.rst:275
msgid "List recipes"
msgstr "列出食譜"

#: ../../ai_assistant.rst:277
msgid "Example prompt: *\"List my recipes.\"*"
msgstr "提示詞範例：*「列出我的食譜。」*"

#: ../../ai_assistant.rst:279
msgid "Search for recipes"
msgstr "搜尋食譜"

#: ../../ai_assistant.rst:281
msgid "Example prompt: *\"Do I have any Spaghetti recipes?\"*"
msgstr "提示詞範例：*「我有意粉食譜嗎？」*"

#: ../../ai_assistant.rst:283
msgid "Get recipe details"
msgstr "取得食譜詳情"

#: ../../ai_assistant.rst:285
msgid ""
"Example prompt: *\"Can you give me the details of my Spaghetti Carbonara "
"recipe?\"*"
msgstr "提示詞範例：*「可以提供我的卡邦尼意粉食譜詳情嗎？」*"

#: ../../ai_assistant.rst:287
msgid "Create a new recipe"
msgstr "建立新食譜"

