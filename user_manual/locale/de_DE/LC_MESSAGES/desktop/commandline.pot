#: ../../desktop/commandline.rst:100
msgid "``--exclude <file>``"
msgstr "``--exclude <file>``"

#: ../../desktop/commandline.rst:101
msgid "System exclude list"
msgstr "Systemausschlussliste"

#: ../../desktop/commandline.rst:102
msgid ""
"Add an exclude list. The file must exist. Pattern anchoring depends on its "
